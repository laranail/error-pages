includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    ignoreErrors:
        # larastan 3.x reports every package view namespace this way: the namespace is
        # registered at RUNTIME by the service provider, and PHPStan does not execute that, so
        # it cannot resolve the literal to a file. The views all exist.
        - '#expects view-string, string given#'

    # Required BECAUSE of the ignore above: only larastan 3.x emits that error, and `composer
    # update` on CI resolves a newer larastan than a long-lived local vendor/ has. With the
    # default (true), the pattern would itself be an unmatched-ignore ERROR wherever the older
    # larastan is installed -- moving the failure rather than fixing it.
    reportUnmatchedIgnoredErrors: false

    paths:
        - src
    excludePaths:
        - vendor
    treatPhpDocTypesAsCertain: false
